<Window x:Class="AnwendungWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="API Test"
        Height="450"
        Width="700">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Addresses returned from API:"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Addresses.Addresses}">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,15">

                        <TextBlock Text="{Binding AddressLine1}"
                                   FontSize="16"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding AddressLine2}"
                                   FontSize="14"/>

                        <TextBlock Text="{Binding Name1}"
                                   FontSize="14"/>

                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

    </Grid>

</Window>