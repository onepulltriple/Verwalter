<UserControl x:Class="AnwendungWPF.Views.ManageAddressesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AnwendungWPF.Views"
             xmlns:viewmodels="clr-namespace:AnwendungWPF.ViewModels"
             xmlns:editorviews="clr-namespace:AnwendungWPF.Views.EditorViews"
             Background="{StaticResource DefaultBackgroundBrush}"
             mc:Ignorable="d" 
             Loaded="ManageAddressesView_Loaded"
             Unloaded="ManageAddressesView_Unloaded"
             PreviewKeyDown="ManageAddressesView_PreviewKeyDown"
             d:DataContext="{d:DesignInstance Type=viewmodels:ManageAddressesViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" 
              Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Style="{StaticResource PopUpWindowHeadingTextStyle}"
                       Text="Manage addresses"/>
            <TextBlock Grid.Row="1" 
                       Style="{StaticResource PopUpWindowBodyTextStyle}"
                       Text="Select an address to edit, or create a new one"/>
        </Grid>

        <StackPanel Grid.Row="0"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    FlowDirection="RightToLeft"
                    VerticalAlignment="Bottom">
            <Button 
                    Style="{StaticResource CrudPrimaryButtonStyle}"
                    Command="{Binding CreateCommand}">
                <TextBlock Text="New"
                           Style="{StaticResource PopUpWindowButtonTextStyle}"/>
            </Button>
        </StackPanel>


        <!-- data list -->
        <DataGrid Grid.Row="1"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  Style="{StaticResource DefaultDataGridStyle}"
                  CellStyle="{StaticResource DefaultDataGridCellStyle}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding ListOfAddresses}"
                  SelectedItem="{Binding SelectedAddress, Mode=TwoWay}"
                  >
            <DataGrid.Columns>
                <DataGridTextColumn Header="AddressLine1"
                                    ElementStyle="{StaticResource DefaultDataGridTextStyle}"
                                    Binding="{Binding AddressLine1}"
                                    Width="*"/>

                <DataGridTextColumn Header="AddressLine2"
                                    ElementStyle="{StaticResource DefaultDataGridTextStyle}"
                                    Binding="{Binding AddressLine2}"
                                    Width="*"/>

                <DataGridTextColumn Header="AddressLine3"
                                    ElementStyle="{StaticResource DefaultDataGridTextStyle}"
                                    Binding="{Binding AddressLine3}"
                                    Width="*"/>

                <DataGridTextColumn Header="Name 1"
                                    ElementStyle="{StaticResource DefaultDataGridTextStyle}"
                                    Binding="{Binding Name1}"
                                    Width="*"/>

                <DataGridTextColumn Header="Name 2"
                                    ElementStyle="{StaticResource DefaultDataGridTextStyle}"
                                    Binding="{Binding Name2}"
                                    Width="*"/>

                <DataGridTemplateColumn Header="Place"
                                        Width="1.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource DefaultDataGridTextStyle}"
                                           Text="{Binding City}"
                                           Margin="0,0,-5,0"/>

                                <TextBlock Style="{StaticResource DefaultDataGridTextStyle}"
                                           Text=","
                                           Margin="0,0,0,0"/>

                                <TextBlock Style="{StaticResource DefaultDataGridTextStyle}"
                                           Text="{Binding Postcode}"
                                           Margin="0"/>

                                <!--<TextBlock Style="{StaticResource DefaultDataGridTextStyle}"
                                           Text=","
                                           Margin="0,0,0,0"/>-->

                                <TextBlock Style="{StaticResource DefaultDataGridTextStyle}"
                                           Text="{Binding Country}"
                                           Margin="-1,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2"
              Grid.Column="0">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource CrudPrimaryButtonStyle}"
                        Command="{Binding EditCommand}">
                    <TextBlock Text="Edit"
                       Style="{StaticResource PopUpWindowButtonTextStyle}"
                       />
                </Button>
                <Button Style="{StaticResource CrudSecondaryButtonStyle}"
                        Command="{Binding DeleteCommand}">
                    <TextBlock Text="Delete"
                       Style="{StaticResource PopUpWindowButtonTextStyle}"
                       />
                </Button>
            </StackPanel>
        </Grid>

        <!-- error message -->
        <TextBlock Grid.Row="2"
                   Grid.Column="1"
                   Style="{StaticResource PopUpWindowWarningBodyTextStyle}"
                   Text="{Binding ErrorMessage}"
                   d:Text="error messages"
                   TextWrapping="Wrap"/>


        <Grid Grid.Row="3"
              Grid.Column="0"
              Grid.ColumnSpan="2">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- editor -->
            <editorviews:AddressEditorView Grid.Column="0"
                                           DataContext="{Binding Editor}"/>

            <StackPanel Grid.Column="1">
                <TextBlock Style="{StaticResource PopUpWindowBodyTextStyle}"
                           Text="Place:"
                           Margin="6,20,6,6"/>
                <ComboBox ItemsSource="{Binding PlacePickerItems}"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedPlaceId,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding Editor.IsEditing}"
                          Style="{StaticResource PopUpWindowComboBoxStyle}">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding City}"/>

                                <TextBlock Text=", "
                                           Margin="1,0,0,0"/>

                                <TextBlock Text="{Binding Postcode}"
                                           Margin="0,0,0,0"/>

                                <TextBlock Text=" "
                                           Margin="1,0,0,0"/>

                                <TextBlock Text="{Binding Country}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

        </Grid>
        
        <Grid Grid.Row="4"
              Grid.Column="1">
            <StackPanel Orientation="Horizontal"
                        FlowDirection="RightToLeft">
                <Button Style="{StaticResource CrudPrimaryButtonStyle}"
                        Command="{Binding SaveCommand}">
                    <TextBlock Text="Save"
                       Style="{StaticResource PopUpWindowButtonTextStyle}"
                       />
                </Button>
                <Button Style="{StaticResource CrudSecondaryButtonStyle}"
                        Command="{Binding CancelCommand}">
                    <TextBlock Text="Discard"
                       Style="{StaticResource PopUpWindowButtonTextStyle}"
                       />
                </Button>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
