<UserControl x:Class="AnwendungWPF.Views.ManageCountriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AnwendungWPF.Views"
             xmlns:viewmodels="clr-namespace:AnwendungWPF.ViewModels"
             xmlns:editorviews="clr-namespace:AnwendungWPF.Views.EditorViews"
             Background="{StaticResource DefaultBackgroundBrush}"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ManageCountriesViewModel}"
             Loaded="ManageCountriesView_Loaded"
             Unloaded="ManageCountriesView_Unloaded"
             PreviewKeyDown="ManageCountriesView_PreviewKeyDown"
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" 
              Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Style="{StaticResource PopUpWindowHeadingTextStyle}"
                       Text="Manage countries"/>
            <TextBlock Grid.Row="1" 
                       Style="{StaticResource PopUpWindowBodyTextStyle}"
                       Text="Select a country to edit, or create a new one"/>
        </Grid>

        <StackPanel Grid.Row="0"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    FlowDirection="RightToLeft"
                    VerticalAlignment="Bottom">
            <Button 
                    Style="{StaticResource CrudPrimaryButtonStyle}"
                    Command="{Binding CreateCommand}">
                <TextBlock Text="New"
                           Style="{StaticResource PopUpWindowButtonTextStyle}"/>
            </Button>
        </StackPanel>


        <!-- data list -->
        <DataGrid Grid.Row="1"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  Style="{StaticResource DefaultDataGridStyle}"
                  CellStyle="{StaticResource DefaultDataGridCellStyle}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding ListOfCountries}"
                  SelectedItem="{Binding SelectedCountry, Mode=TwoWay}"
                  >
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"
                                    ElementStyle="{StaticResource DefaultDataGridTextStyle}"
                                    Binding="{Binding NameEnGb}"
                                    Width="*"/>

                <DataGridTextColumn Header="ISO 2"
                                    ElementStyle="{StaticResource DefaultDataGridTextStyle}"
                                    Binding="{Binding IsoAlpha2}"
                                    Width="0.5*"/>

                <DataGridTextColumn Header="ISO 3"
                                    ElementStyle="{StaticResource DefaultDataGridTextStyle}"
                                    Binding="{Binding IsoAlpha3}"
                                    Width="0.5*"/>

                <DataGridCheckBoxColumn Header="Active"
                                        ElementStyle="{StaticResource DefaultDataGridCheckBoxStyle}"
                                        Binding="{Binding Active}"
                                        Width="0.2*"/>

            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2"
              Grid.Column="0">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource CrudPrimaryButtonStyle}"
                        Command="{Binding EditCommand}">
                    <TextBlock Text="Edit"
                       Style="{StaticResource PopUpWindowButtonTextStyle}"
                       />
                </Button>
                <Button Style="{StaticResource CrudSecondaryButtonStyle}"
                        Command="{Binding DeleteCommand}">
                    <TextBlock Text="Delete"
                       Style="{StaticResource PopUpWindowButtonTextStyle}"
                       />
                </Button>
            </StackPanel>
        </Grid>
        
        <!-- error message -->
        <TextBlock Grid.Row="2"
                    Grid.Column="1"
                    Style="{StaticResource PopUpWindowWarningBodyTextStyle}"
                    Text="{Binding ErrorMessage}"
                    d:Text="error messages"
                    TextWrapping="Wrap"/>


        <Grid Grid.Row="3"
              Grid.Column="0"
              Grid.ColumnSpan="2">

            <!-- editor -->
            <editorviews:CountryEditorView DataContext="{Binding Editor}"/>

        </Grid>
        <Grid Grid.Row="4"
              Grid.Column="1">
            <StackPanel Orientation="Horizontal"
                        FlowDirection="RightToLeft">
                <Button Style="{StaticResource CrudPrimaryButtonStyle}"
                        Command="{Binding SaveCommand}">
                    <TextBlock Text="Save"
                       Style="{StaticResource PopUpWindowButtonTextStyle}"
                       />
                </Button>
                <Button Style="{StaticResource CrudSecondaryButtonStyle}"
                        Command="{Binding CancelCommand}">
                    <TextBlock Text="Discard"
                       Style="{StaticResource PopUpWindowButtonTextStyle}"
                       />
                </Button>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
